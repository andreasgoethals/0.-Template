{
  // Committed on purpose — see the note in .gitignore. Everything here follows from the
  // repository's layout rather than from anyone's taste.

  // The repository root on the analysis path. WHY: `src/` is a FLAT package root
  // (src/data, src/utils, src/visualize), so every import reads `from src.utils.paths import
  // ...`. Without this, Pylance cannot resolve any of them in a fresh clone and underlines
  // every import in every file until someone runs `pip install -e .`.
  "python.analysis.extraPaths": ["."],
  "python.analysis.typeCheckingMode": "basic",

  // Tests are discovered from tests/, which is where pyproject.toml points pytest too.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Ruff for both linting and formatting, using the configuration in pyproject.toml.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // 100 columns, matching [tool.ruff] line-length in pyproject.toml.
  "editor.rulers": [100],

  // Notebooks run from the repository root, as `python -m src.utils.run_notebooks` does.
  // Without this a notebook's cwd is notebooks/ and `from src...` fails only interactively —
  // the worst kind of difference, because interactive is where figures are iterated on.
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // Exclude shared reference libraries from ordinary project-code searches and analysis.
  // Read them explicitly when reviewing research or infrastructure guidance.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "tfm-library": true,
    "vsc-library": true,
    "dm-library": true,
    "output": true,
    "data": true,
    ".venv": true
  },
  "python.analysis.exclude": ["tfm-library", "vsc-library", "dm-library", "output", "data"],

  // Editor protection supports the read-only contract; it is not a filesystem permission.
  "files.readonlyInclude": {
    "tfm-library/**": true,
    "vsc-library/**": true,
    "dm-library/**": true
  },
  "files.readonlyExclude": {
    "tfm-library/PROJECT_SPECIFIC.md": true,
    "dm-library/PROJECT_SPECIFIC.md": true
  },

  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
